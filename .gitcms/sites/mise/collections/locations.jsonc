{
  "git_path": "/content/locations/",
  "file_extension": ".mdx",
  "filename_pattern": "",
  "collection_type": "flat",
  "frontmatter_schema": [
    {
      "name": "name",
      "type": "title",
      "label": "Name"
    },
    {
      "name": "neighborhood",
      "type": "text",
      "label": "Neighborhood"
    },
    {
      "name": "street",
      "type": "text",
      "label": "Street"
    },
    {
      "name": "city",
      "type": "text",
      "label": "City"
    },
    {
      "name": "postalCode",
      "type": "text",
      "label": "Postal Code"
    },
    {
      "name": "hours",
      "type": "list",
      "label": "Hours",
      "itemLabel": "{days}",
      "fields": [
        {
          "name": "days",
          "type": "text",
          "label": "Days",
          "required": false
        },
        {
          "name": "hours",
          "type": "text",
          "label": "Hours",
          "required": false
        }
      ]
    },
    {
      "name": "phone",
      "type": "text",
      "label": "Phone"
    },
    {
      "name": "mapsUrl",
      "type": "url",
      "label": "Maps Url"
    },
    {
      "name": "order",
      "type": "number",
      "label": "Order"
    },
    {
      "name": "featured",
      "type": "boolean",
      "label": "Featured",
      "default": true
    }
  ]
}
